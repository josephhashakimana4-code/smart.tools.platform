NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/toolsdb?retryWrites=true&w=majority

# =====================================
# SECURITY & AUTHENTICATION
# =====================================

ADMIN_PASSWORD=change-this-strong-admin-password

# JWT Configuration
JWT_ACCESS_SECRET=change_this_secret_key_in_production_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_key_in_production_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=SmartToolsHub
JWT_AUDIENCE=SmartToolsHubUsers

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,https://yourdomain.com

# =====================================
# EMAIL CONFIGURATION
# =====================================

# SMTP Settings (for verification emails, password reset, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@smarttools.com

# =====================================
# THIRD-PARTY SERVICES
# =====================================

PAYPAL_ACCOUNT_EMAIL=
PAYPAL_URL=
GOOGLE_ANALYTICS_ID=
ADSENSE_PUBLISHER_ID=
PROPELLER_ADS_CODE=
ADSTERRA_CODE=

# =====================================
# FEATURE FLAGS
# =====================================

ENABLE_USER_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_AFFILIATE_SYSTEM=true

# =====================================
# LOGGING
# =====================================

LOG_LEVEL=info
AUDIT_LOG_ENABLED=true

# =====================================
# REDIS (Optional - for sessions/caching)
# =====================================

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# =====================================
# OTHER
# =====================================

API_BASE_URL=http://localhost:5000

{
  "info": {
    "name": "Smart Tools Platform - Security Test Suite",
    "description": "Complete security testing collection for Smart Tools Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. CSRF & Token Management",
      "item": [
        {
          "name": "Get CSRF Token",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/auth/csrf-token",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "csrf-token"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has csrfToken', function () { pm.expect(pm.response.json().csrfToken).to.be.ok; });",
                  "pm.environment.set('csrfToken', pm.response.json().csrfToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. User Registration",
      "item": [
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@security.test\",\n  \"password\": \"SecurePass123!\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Registration successful', function () { pm.expect(pm.response.json().success).to.equal(true); });",
                  "pm.test('Response has userId', function () { pm.expect(pm.response.json().userId).to.be.ok; });",
                  "pm.environment.set('userId', pm.response.json().userId);",
                  "pm.environment.set('testEmail', 'testuser@security.test');"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Duplicate Email (Should Fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@security.test\",\n  \"password\": \"SecurePass123!\",\n  \"firstName\": \"Duplicate\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 (Conflict)', function () { pm.response.to.have.status(409); });",
                  "pm.test('Duplicate email rejected', function () { pm.expect(pm.response.json().success).to.equal(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Weak Password (Should Fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"weak@security.test\",\n  \"password\": \"weak\",\n  \"firstName\": \"Test\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Weak password rejected', function () { pm.expect(pm.response.json().success).to.equal(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Invalid Email (Should Fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"SecurePass123!\",\n  \"firstName\": \"Test\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Invalid email rejected', function () { pm.expect(pm.response.json().success).to.equal(false); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. User Login",
      "item": [
        {
          "name": "Login - Wrong Password (Should Fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@security.test\",\n  \"password\": \"WrongPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Wrong password rejected', function () { pm.expect(pm.response.json().success).to.equal(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Non-existent User (Should Fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nonexistent@security.test\",\n  \"password\": \"AnyPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Non-existent user rejected', function () { pm.expect(pm.response.json().success).to.equal(false); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Token Refresh",
      "item": [
        {
          "name": "Refresh Token - Invalid (Should Fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"invalid_token_here\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "refresh"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Invalid refresh token rejected', function () { pm.expect(pm.response.json().success).to.equal(false); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Password Reset",
      "item": [
        {
          "name": "Forgot Password - Valid Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@security.test\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "forgot-password"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Success response', function () { pm.expect(pm.response.json().success).to.equal(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot Password - Non-existent Email (Should be same response)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nonexistent@security.test\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "forgot-password"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 (security)', function () { pm.response.to.have.status(200); });",
                  "pm.test('Does not reveal if email exists', function () { pm.expect(pm.response.json().success).to.equal(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset Password - Invalid Token (Should Fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetToken\": \"invalid_token\",\n  \"newPassword\": \"NewSecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "reset-password"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Invalid reset token rejected', function () { pm.expect(pm.response.json().success).to.equal(false); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Protected Endpoints",
      "item": [
        {
          "name": "Get Profile - No Token (Should Fail)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Authorization required', function () { pm.expect(pm.response.json().success).to.equal(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Profile - Invalid Token (Should Fail)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer invalid_token"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Invalid token rejected', function () { pm.expect(pm.response.json().success).to.equal(false); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "7. Security Headers",
      "item": [
        {
          "name": "Check Security Headers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Has HSTS header', function () { pm.expect(pm.response.headers.get('Strict-Transport-Security')).to.be.ok; });",
                  "pm.test('Has X-Content-Type-Options header', function () { pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.be.ok; });",
                  "pm.test('Has X-Frame-Options header', function () { pm.expect(pm.response.headers.get('X-Frame-Options')).to.be.ok; });",
                  "pm.test('X-Frame-Options is DENY', function () { pm.expect(pm.response.headers.get('X-Frame-Options')).to.equal('DENY'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "8. Input Validation",
      "item": [
        {
          "name": "Register with XSS Payload (Should Sanitize)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"xss@security.test\",\n  \"password\": \"SecurePass123!\",\n  \"firstName\": \"<script>alert('xss')</script>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('XSS payload handled safely', function () { pm.expect(pm.response.json().success).to.be.ok; });"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "csrfToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "",
      "type": "string"
    }
  ]
}
